# Copy this file to .env and change the values before running docker compose.

# Airflow metadata database
AIRFLOW_FERNET_KEY=        # generate with: python fernet.py
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_URI=postgresql+psycopg2://airflow:change-me@airflow_metadata/airflow

# Source database (bookings schema)
PACFLIGHT_DB_USER=postgres
PACFLIGHT_DB_PASSWORD=change-me
PACFLIGHT_DB_NAME=pacflight

# Warehouse (stg and final schema)
WAREHOUSE_DB_USER=postgres
WAREHOUSE_DB_PASSWORD=change-me
WAREHOUSE_DB_NAME=warehouse_pacflight

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio
